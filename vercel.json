{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/expire-points",
      "schedule": "0 2 * * *"
    }
  ]
}
